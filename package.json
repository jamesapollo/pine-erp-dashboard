{
  "name": "erp-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:api": "npm run build -- --outDir ../commerce-erp-api/public/admin --emptyOutDir",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
